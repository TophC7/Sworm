{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sworm",
  "identifier": "dev.sworm",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Chris Toph <toph@ryot.foo>",
    "homepage": "https://github.com/TophC7/Sworm",
    "category": "DeveloperTool",
    "shortDescription": "Linux-first desktop app for coding-agent CLIs",
    "longDescription": "Sworm is a Linux-first desktop development environment for working with coding-agent CLIs.",
    "icon": [
      "icons/16x16.png",
      "icons/22x22.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/36x36.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/72x72.png",
      "icons/96x96.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/192x192.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["git", "libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": {
          "/usr/share/doc/sworm/LICENSE": "../LICENSE"
        },
        "section": "devel",
        "desktopTemplate": "sworm.desktop"
      }
    }
  }
}
