{
	"explorer": {
		"compact_folders": true,
		"exclude": {
			"**/.DS_Store": true,
			"**/.git": true,
			"**/.hg": true,
			"**/.svn": true,
			"**/Thumbs.db": true,
			"**/.bun": true,
			".svelte-kit": true,
			".svelte-kit-web": true,
			"build": true,
			"build-web": true,
			"dist": true,
			"node_modules": true,
			"target": true
		},
		"exclude_gitignore": false
	}
}
